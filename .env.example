# =============================================================================
# The Logical Agent — Environment Configuration
# Copy to .env and fill in values. Never commit secrets.
# =============================================================================

APP_NAME=The Logical Agent
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string-at-least-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MFA_ISSUER=The Logical Agent

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tla
POSTGRES_PASSWORD=tla_secure_change_me
POSTGRES_DB=the_logical_agent
DATABASE_URL=postgresql+asyncpg://tla:tla_secure_change_me@postgres:5432/the_logical_agent
DATABASE_URL_SYNC=postgresql://tla:tla_secure_change_me@postgres:5432/the_logical_agent

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=tla

# Object Storage (S3-compatible / MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tla-media
S3_REGION=us-east-1
CDN_URL=http://localhost:9000/tla-media

# =============================================================================
# LLM — Free-first (recommended). Set DEFAULT_LLM_PROVIDER=auto
# Priority: Groq → Gemini → OpenRouter → Ollama → Hugging Face → paid
# =============================================================================
DEFAULT_LLM_PROVIDER=auto
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini free tier — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter free models — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama local (fully free) — https://ollama.com
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Hugging Face Inference free tier — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=HuggingFaceH4/zephyr-7b-beta

# Optional paid providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Free data sources (no key required for most)
# Optional GitHub token raises rate limits for repo discovery
GITHUB_API_TOKEN=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000/api/v1/auth/oauth

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Social Distribution
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
LINKEDIN_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
DISCORD_WEBHOOK_URL=

# Email / Newsletter
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@thelogicalagent.com
SMTP_TLS=false
SENDGRID_API_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true

# Rate limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_AI=30/minute

# Feature flags
FEATURE_AI_AGENTS=true
FEATURE_SOCIAL=true
FEATURE_MONETIZATION=true
FEATURE_NEWSLETTER=true
FEATURE_DISTRIBUTION=true

# NewsAPI.org � https://newsapi.org
NEWS_API_KEY=

